DATABASE_URL=sqlite:///./opspilot.db
# Generate with: openssl rand -hex 32  (required in production)
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: enables Claude-powered incident analysis. Without it, a rule engine is used.
# NOTE: when set, redacted error-log excerpts are sent to the Anthropic API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
